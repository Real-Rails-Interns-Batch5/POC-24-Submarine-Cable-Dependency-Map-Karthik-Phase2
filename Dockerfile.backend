# ==========================================
# STAGE 1: Builder Stage (Dependency Compilation)
# ==========================================
FROM python:3.12-slim AS builder

# Set Python build environment flags
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Create Python virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy backend requirements file to leverage Docker layer caching
COPY backend/requirements.txt ./backend/requirements.txt

# Install Python dependencies without caching wheel files to reduce size
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r backend/requirements.txt

# ==========================================
# STAGE 2: Production Minimal Runtime
# ==========================================
FROM python:3.12-slim AS runner

# Set Python production runtime flags
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Create unprivileged system user for non-root execution
RUN addgroup --system appgroup && \
    adduser --system --ingroup appgroup appuser

# Copy virtual environment binaries and libraries from builder
COPY --from=builder /opt/venv /opt/venv

# Copy backend source code and data assets
COPY --chown=appuser:appgroup backend ./backend
COPY --chown=appuser:appgroup run.py ./run.py

USER appuser

EXPOSE 8000

# Execute FastAPI via Uvicorn server bound to 0.0.0.0 and dynamic $PORT
CMD ["sh", "-c", "python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

